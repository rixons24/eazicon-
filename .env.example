# --- Server ---
PORT=3000
NODE_ENV=development

# --- Database ---
# On Render, this is auto-injected when you attach a Postgres instance
DATABASE_URL=postgresql://user:pass@localhost:5432/karibu

# --- Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-in-production

# --- AI providers ---
GROQ_API_KEY=your_groq_key_here
GROQ_LLM_MODEL=openai/gpt-oss-20b
GROQ_STT_MODEL=whisper-large-v3

# Dedicated translation model — separate from GROQ_LLM_MODEL (which handles
# tier classification). Defaults to a larger model since translation quality
# on lower-resource languages (Swahili, Amharic) matters even on the free plan.
GROQ_TRANSLATE_MODEL=openai/gpt-oss-120b

# Translation provider: 'groq' (default) or 'gemini'. Gemini tends to handle
# Swahili and other African/lower-resource languages more reliably — set this
# to 'gemini' and add GEMINI_API_KEY below to switch, no code changes needed.
TRANSLATION_PROVIDER=groq
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

ELEVENLABS_API_KEY=your_elevenlabs_key_here
ELEVENLABS_DEFAULT_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# --- Frontend origins for CORS ---
# Comma-separated list. Add your production domain here when live.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://karibu.ai
